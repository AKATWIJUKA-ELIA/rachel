                "children": [],
                "todo": {
                  "content": "admin/storage.php:950-987 — Builder upload filenames retain an unchecked extension and media blocks use unescaped generated filenames in HTML attributes; allowlist media types/extensions, encode URL/attribute values, and validate every move result.",
                  "id": 1792368000110,
                  "level": "warning",
                  "done": true,
                  "start": 1792368000110,
                  "focus": false,
